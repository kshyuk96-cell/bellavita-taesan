+
+/* Shared native details: Enter/Space/touch toggles without custom script. */
+.review-term { margin-block: .65rem; overflow-wrap: anywhere; }
+.review-term summary { cursor: pointer; min-height: 44px; padding: .6rem; }
+.review-term summary:focus-visible { outline: 3px solid #174f85; outline-offset: 3px; }
+.review-term p { padding: .6rem; max-width: 70ch; }
